# memgres configuration — every operational limit is here.
# Copy to .env and adjust. Defaults suit a single-user embedded deployment.

# ─── database ────────────────────────────────────────────────────────────
# Either set MEMGRES_DATABASE_URL, or use the standard libpq PG* vars.
MEMGRES_DATABASE_URL=postgresql://pgmem:pgmem@localhost:5432/pgmem
MEMGRES_POOL_SIZE=4                 # max pooled DB connections (HTTP + http-MCP
                                 # servers). 1 = serialize; raise for concurrent clients

# ─── storage limits (bytes) ──────────────────────────────────────────────
MEMGRES_MAX_BODY_BYTES=262144      # 256 KB — ceiling for a whole record body
MEMGRES_MAX_WRITE_BYTES=16384      # 16 KB — ceiling for one write/diff payload
                                 # (must be <= MAX_BODY; large bodies grow via diffs)
MEMGRES_MAX_SOURCE_BYTES=2048      # 2 KB — ceiling for a write's provenance `source`
MEMGRES_MAX_REASON_BYTES=1024      # 1 KB — ceiling for a write's provenance `reason`
MEMGRES_MAX_TITLE_BYTES=256        # ceiling for a memory's curated `title` (distinct from body)

# ─── retention ───────────────────────────────────────────────────────────
MEMGRES_RETENTION_DAYS=0           # 0 = keep forever; >0 = expire N days after last touch
MEMGRES_RENEW_ON_READ=true         # a read pushes the expiry clock forward

# ─── identity / multi-tenant isolation (see docs/TENANCY.md) ─────────────
MEMGRES_KEY_MODE=single            # single = no auth, one space (default)
                                 # open   = bring-your-own mgk_ token, self-registers on first write
                                 # managed= only admin-provisioned tokens
MEMGRES_ADMIN_TOKEN=               # managed: bootstrap/break-glass bearer. Seeds the first admin
                                 # at startup (once, when zero admins exist), then resolves to that
                                 # real user. Must be a strong mgk_ token to be seeded.
# MEMGRES_ADMIN_TOKEN_FILE=        # …or a path, read-or-create: holds a token → used; empty/missing →
                                 # generate one, write it 0600, log the PATH only. (Not with the above.)
MEMGRES_ADMIN_ROLE=user_manager    # role the bootstrap admin is seeded with: user_manager | superadmin
MEMGRES_TOKEN=                     # default token used when a call passes none — set this
                                 # (e.g. in an MCP client's env) so one deployment = one tenant
# MCP only: expose a `token` tool arg to the model? auto (default) = only on a
# multi-tenant endpoint with no pinned token; on/off force it.
# MEMGRES_MCP_TOKEN_ARG=auto

# MCP only: register the control-plane tools (memory_admin_*, memory_whoami)?
# auto (default) = wherever there are identities to administer, i.e. every mode
# but `single`. Turning them off shortens an agent-facing tool list; it is a
# context economy, NOT a security boundary — each tool authorizes when called.
# MEMGRES_MCP_ADMIN_TOOLS=auto

# Encryption at rest is a deployment concern, not a memgres setting: use your
# Postgres/disk TDE (managed PG, LUKS, pgcrypto) — it stays transparent to queries
# so search keeps working. memgres does not encrypt bodies application-side (that
# would make them unsearchable). GDPR erasure is handled by hard-delete + history
# crypto-shred, which only runs on forget() and never touches search.

# ─── organization ────────────────────────────────────────────────────────
MEMGRES_TREE=true                  # ltree path column + GiST index for fast subtree selection
                                 # (path <@ 'a.b' pulls a whole subtree in one index scan).
                                 # Tags (text[] + GIN) are always available, no flag needed.
MEMGRES_REQUIRE_PARENT=false       # false = sparse paths ok (create food.apple with no food row);
                                 # true  = a node's parent path must already exist as a memory

# ─── history ─────────────────────────────────────────────────────────────
MEMGRES_HISTORY=true               # keep the hash-chained diff history (deleted with the record)

# ─── search ──────────────────────────────────────────────────────────────
MEMGRES_FTS_LANGUAGE=simple        # Postgres FTS dictionary: simple | english | russian | …
MEMGRES_VECTOR_BACKEND=pgvector    # pgvector (same DB, default) | qdrant (separate service)
MEMGRES_LEXICAL_MATCH=any          # any = OR the query's words (ranked partial matches, default)
                                 # all = AND them (a hit must contain every word)

# ─── recall snippets ───────────────────────────────────────────────────────
MEMGRES_SNIPPET=true               # return a relevant slice of each hit (off = whole body)
MEMGRES_FULL_BODY=false            # true = force the whole body on every hit; false = auto
                                 # (short bodies whole, long ones sliced). One view per hit.
MEMGRES_FULL_BODY_MAX_CHARS=500    # a body this short comes back whole (kind=full), not sliced
MEMGRES_SNIPPET_SEMANTIC=true      # semantic/hybrid hits use their best-matching CHUNK as the
                                 # snippet — chunks are already embedded by the index, so this
                                 # is free at recall time; false = fall back to ts_headline (lexical)
MEMGRES_CHUNK_CHARS=400            # chunk size (chars) for the semantic index (ranking + snippet)
                                 # legacy name MEMGRES_SNIPPET_SEG_CHARS still works
MEMGRES_CHUNK_OVERLAP=80           # chars shared between consecutive chunks (legacy _SNIPPET_SEG_OVERLAP)
MEMGRES_LIST_PREVIEW_CHARS=120     # first-line preview length in memory_list / GET /memories
MEMGRES_LIST_BODIES_MAX_BYTES=200000  # total body bytes one `bodies=true` browse returns; rows
                                 # past the cap come back marked `body_omitted`, never dropped

# ─── embeddings (semantic recall) ────────────────────────────────────────
# Switch local <-> cloud <-> self-hosted by changing PROVIDER alone.
#   none              lexical only, no model
#   local             sentence-transformers in-process (needs the [local] extra)
#   openai            OpenAI cloud            (key required)
#   jina              Jina cloud              (key required, passage/query task hints)
#   openai-compatible any OpenAI-shaped /embeddings server (LM Studio, Ollama,
#                     vLLM, TEI, LocalAI …): set API_BASE, key optional
MEMGRES_EMBED_PROVIDER=none
MEMGRES_EMBED_MODEL=               # e.g. all-MiniLM-L6-v2 | jina-embeddings-v3 | text-embedding-3-small
MEMGRES_EMBED_DIM=                 # required for HTTP providers; local infers it
MEMGRES_EMBED_API_KEY=             # token for cloud providers
MEMGRES_EMBED_API_BASE=            # server URL; required for openai-compatible, overrides default otherwise
MEMGRES_EMBED_MAX_SEQ=            # 0/blank = keep the local model's default; >0 overrides its max sequence length (tokens)

# Examples for self-hosted OpenAI-compatible servers:
#   LM Studio :  PROVIDER=openai-compatible  API_BASE=http://localhost:1234/v1  MODEL=<loaded model>  DIM=768
#   Ollama    :  PROVIDER=openai-compatible  API_BASE=http://localhost:11434/v1 MODEL=nomic-embed-text DIM=768

# ─── embedding pipeline (how/when chunks get embedded) ────────────────────
# inline = embed within the write — safe default, no worker (library & all-in-one).
# async  = the write only flags the row; a worker embeds off the request path.
# A server sets async automatically when it runs an in-process worker. For a split
# deployment (docs/DEPLOYMENT.md) set async + MEMGRES_EMBED_WORKER=false on the API
# tier and run separate `memgres-worker` processes.
MEMGRES_EMBED_DISPATCH=inline      # inline | async
MEMGRES_EMBED_WORKER=true          # a server process runs an in-process embed worker
MEMGRES_EMBED_WORKER_INTERVAL=1.0  # worker idle poll seconds between drains
MEMGRES_EMBED_MAX_ATTEMPTS=5       # a row failing to embed is retried, then dead-lettered
MEMGRES_EMBED_RETRY_BACKOFF_S=60   # seconds to wait between retries of a failing row

# ─── qdrant (only if MEMGRES_VECTOR_BACKEND=qdrant) ────────────────────────
# Qdrant ranks vectors; Postgres still holds bodies and does tag/subtree/TTL filtering.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# MEMGRES_QDRANT_COLLECTION=memgres
# MEMGRES_QDRANT_CA=              # path to a CA/self-signed cert, only for an https Qdrant
